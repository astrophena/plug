    {
      "name": "golden.get",
      "documentation": "golden.get returns an item when it exists.\n\n# Lookup\n\nSee [Item], [golden.update], and [golden.open]. Unknown [Missing] stays literal.\n\n  - Return an [Item].\n  - Report an [APIError] on failure.\n\nExample:\n\n\t[golden.get] id: 1\n\t    [Item]",
      "id": 1196762900,
      "fields": [
        {
          "name": "id",
          "documentation": "id identifies the item.\n\nUse the [ItemID] from [golden.update].",
          "type": {
            "kind": "named",
            "name": "ItemID",
            "optional": false
          }
        },
        {
          "name": "labels",
          "documentation": "labels filters item labels.",
          "type": {
            "kind": "list",
            "element": {
              "kind": "primitive",
              "name": "string",
              "optional": false
            },
            "optional": true
          }
        },
        {
          "name": "token",
          "documentation": "token carries an opaque token.",
          "type": {
            "kind": "primitive",
            "name": "bytes",
            "optional": true
          }
        }
      ],
      "response": {
        "kind": "named",
        "name": "Item",
        "optional": true
      },
      "error": "APIError",
      "public": false,
      "permission": "item.read",
      "http": [
        {
          "verb": "GET",
          "path": "/items/{id}"
        },
        {
          "verb": "POST",
          "path": "/lookup"
        }
      ]
    },
    {
      "name": "golden.listItems",
      "documentation": "golden.listItems lists items up to the optional limit.",
