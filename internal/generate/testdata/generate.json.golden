{
  "format_version": 1,
  "protocol_version": 1,
  "package": "golden",
  "major": 1,
  "family": "bab6862c37b655e38034d35c798bce42d1812761252f3f9a0f14af6398475b6d",
  "fingerprint": "ecce87213eae6b1a098ade07d85b3d8e5a25e43e50afb155981793bdbb6e836a",
  "source": "// golden describes generator golden tests.\n//\n// Read an [Item] with [golden.get]. See [the guide].\n//\n// [the guide]: https://example.com/guide\npackage golden version 1\n\n// item.read allows callers to read items.\npermission item.read\n\n// ItemID represents an item identifier.\ntype ItemID = i64\n\n// APIError represents an item API error.\ntype APIError\n\n// invalid indicates that an item request was invalid.\ninvalid\n  // reason contains the failure reason.\n  reason: string\n= APIError httpStatus 400\n\n// notFound indicates that an item was not found.\nnotFound\n  // id identifies the missing item.\n  id: ItemID\n= APIError httpStatus 404\n\n// Choice represents an item choice.\ntype Choice\n\n// left represents the left choice.\nleft\n  // label contains the choice label.\n  label: string\n= Choice\n\n// right represents the right choice.\nright = Choice\n\n// item represents an item.\nitem\n  // id identifies the item.\n  id: ItemID\n  // labels contains item labels.\n  labels: list<string>\n  // values contains nested values.\n  values: list<list<u32>>\n  // choice selects the item choice.\n  choice: Choice\n  // note contains an optional note.\n  note: string?\n= Item\n\n// failed reports that a stream could not be opened.\nfailed\n  // reason describes the failure.\n  reason: string\n= OpenError\n\n// golden.attach opens a raw stream without request fields.\ngolden.attach -> raw public\n\n// golden.connect opens a raw stream or returns a declared error.\ngolden.connect\n  // id identifies the stream.\n  id: ItemID\n-> raw\n  throws OpenError\n  public\n\n// golden.get returns an item when it exists.\n//\n// # Lookup\n//\n// See [Item], [golden.update], and [golden.open]. Unknown [Missing] stays literal.\n//\n//   - Return an [Item].\n//   - Report an [APIError] on failure.\n//\n// Example:\n//\n//\t[golden.get] id: 1\n//\t    [Item]\ngolden.get\n  // id identifies the item.\n  //\n  // Use the [ItemID] from [golden.update].\n  id: ItemID\n  // labels filters item labels.\n  labels: list<string>?\n  // token carries an opaque token.\n  token: bytes?\n-> Item?\n  throws APIError\n  requires item.read\n  http GET \"/items/{id}\"\n  http POST \"/lookup\"\n\n// golden.listItems lists items up to the optional limit.\ngolden.listItems\n  // limit caps the number of returned items.\n  limit: u32?\n-> list<Item>\n  public\n  http GET \"/items\"\n\n// golden.open opens a raw stream.\ngolden.open\n  // id identifies the stream.\n  id: ItemID\n-> raw public\n\n// golden.ping checks service health.\ngolden.ping -> void\n  public\n  http GET \"/healthz\"\n\n// golden.update updates an item.\ngolden.update\n  // id identifies the item.\n  id: ItemID\n  // item contains the replacement item.\n  item: Item\n-> void\n  public\n  http PUT \"/items/{id}\"\n",
  "documentation": "golden describes generator golden tests.\n\nRead an [Item] with [golden.get]. See [the guide].\n\n[the guide]: https://example.com/guide",
