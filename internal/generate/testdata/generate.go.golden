		body := enc.BeginRecord()
		codecItemID.Encode(enc, v.ID)
		plugimpl.ListCodec(plugimpl.StringCodec).Encode(enc, v.Labels)
		plugimpl.ListCodec(plugimpl.ListCodec(plugimpl.U32Codec)).Encode(enc, v.Values)
		codecChoice.Encode(enc, v.Choice)
		if v.Note.Present() {
			plugimpl.OptionalCodec(plugimpl.StringCodec).Encode(enc, v.Note)
		}
		enc.EndValue(body)
	},
	Decode: func(dec *plugimpl.Decoder) (v Item) {
		body := dec.BeginRecord()
		v.ID = codecItemID.Decode(dec)
		v.Labels = plugimpl.ListCodec(plugimpl.StringCodec).Decode(dec)
		v.Values = plugimpl.ListCodec(plugimpl.ListCodec(plugimpl.U32Codec)).Decode(dec)
		v.Choice = codecChoice.Decode(dec)
		v.Note = plugimpl.OptionalCodec(plugimpl.StringCodec).Decode(dec)
		dec.FinishValue(body)
		return v
	},
}

var errorsOpenError = plugimpl.ErrorCodec{
	Encode: func(enc *plugimpl.Encoder, err error) (uint32, bool) {
		var v *OpenError
		if !errors.As(err, &v) {
			return 0, false
		}
		if v == nil {
			enc.Unsupported("OpenError", v)
			return 0, true
		}
		plugimpl.StringCodec.Encode(enc, v.Reason)
		return constructorIDFailed, true
	},
	Identify: func(err error) (uint32, bool) {
		var v *OpenError
		if !errors.As(err, &v) {
			return 0, false
		}
		if v == nil {
			return 0, false
		}
		return constructorIDFailed, true
	},
	Decode: func(dec *plugimpl.Decoder, id uint32) error {
		switch id {
		case constructorIDFailed:
			if !plugimpl.Reserve[OpenError](dec, 1) {
				return nil
			}
			v := new(OpenError)
			v.Reason = plugimpl.StringCodec.Decode(dec)
			dec.IgnoreRemaining()
			return v
		default:
			dec.UnknownConstructor("OpenError", id)
			return nil
		}
	},
}

var codecConnectRequest = plugimpl.Codec[ConnectRequest]{
	Encode: func(enc *plugimpl.Encoder, v ConnectRequest) {
		codecItemID.Encode(enc, v.ID)
	},
	Decode: func(dec *plugimpl.Decoder) (v ConnectRequest) {
		v.ID = codecItemID.Decode(dec)
		dec.IgnoreRemaining()
		return v
	},
}

var codecGetRequest = plugimpl.Codec[GetRequest]{
	Encode: func(enc *plugimpl.Encoder, v GetRequest) {
		codecItemID.Encode(enc, v.ID)
		last := plugimpl.LastPresent(v.Labels.Present(), v.Token.Present())
		if last >= 0 {
			plugimpl.OptionalCodec(plugimpl.ListCodec(plugimpl.StringCodec)).Encode(enc, v.Labels)
		}
		if last >= 1 {
			plugimpl.OptionalCodec(plugimpl.BytesCodec).Encode(enc, v.Token)
		}
	},
	Decode: func(dec *plugimpl.Decoder) (v GetRequest) {
		v.ID = codecItemID.Decode(dec)
		v.Labels = plugimpl.OptionalCodec(plugimpl.ListCodec(plugimpl.StringCodec)).Decode(dec)
		v.Token = plugimpl.OptionalCodec(plugimpl.BytesCodec).Decode(dec)
		dec.IgnoreRemaining()
		return v
	},
}

var codecListItemsRequest = plugimpl.Codec[ListItemsRequest]{
	Encode: func(enc *plugimpl.Encoder, v ListItemsRequest) {
		if v.Limit.Present() {
			plugimpl.OptionalCodec(plugimpl.U32Codec).Encode(enc, v.Limit)
		}
	},
	Decode: func(dec *plugimpl.Decoder) (v ListItemsRequest) {
		v.Limit = plugimpl.OptionalCodec(plugimpl.U32Codec).Decode(dec)
		dec.IgnoreRemaining()
		return v
	},
}

var codecOpenRequest = plugimpl.Codec[OpenRequest]{
	Encode: func(enc *plugimpl.Encoder, v OpenRequest) {
		codecItemID.Encode(enc, v.ID)
	},
	Decode: func(dec *plugimpl.Decoder) (v OpenRequest) {
		v.ID = codecItemID.Decode(dec)
		dec.IgnoreRemaining()
		return v
	},
}

var codecUpdateRequest = plugimpl.Codec[UpdateRequest]{
	Encode: func(enc *plugimpl.Encoder, v UpdateRequest) {
		codecItemID.Encode(enc, v.ID)
		codecItem.Encode(enc, v.Item)
	},
	Decode: func(dec *plugimpl.Decoder) (v UpdateRequest) {
		v.ID = codecItemID.Decode(dec)
		v.Item = codecItem.Decode(dec)
		dec.IgnoreRemaining()
		return v
	},
}

var methodAttach = plugimpl.NewRawMethod(
	&Schema,
	methodIDAttach,
	plugimpl.VoidCodec,
	plugimpl.ErrorCodec{},
)

var methodConnect = plugimpl.NewRawMethod(
	&Schema,
	methodIDConnect,
	codecConnectRequest,
	errorsOpenError,
)

var methodGet = plugimpl.NewMethod(
	&Schema,
	methodIDGet,
	codecGetRequest,
	plugimpl.OptionalCodec(codecItem),
	errorsAPIError,
)

var methodListItems = plugimpl.NewMethod(
	&Schema,
	methodIDListItems,
	codecListItemsRequest,
	plugimpl.ListCodec(codecItem),
	plugimpl.ErrorCodec{},
)

var methodOpen = plugimpl.NewRawMethod(
	&Schema,
	methodIDOpen,
	codecOpenRequest,
	plugimpl.ErrorCodec{},
)

var methodPing = plugimpl.NewMethod(
	&Schema,
	methodIDPing,
	plugimpl.VoidCodec,
	plugimpl.VoidCodec,
	plugimpl.ErrorCodec{},
)

var methodUpdate = plugimpl.NewMethod(
	&Schema,
	methodIDUpdate,
	codecUpdateRequest,
	plugimpl.VoidCodec,
	plugimpl.ErrorCodec{},
)

// Handlers contains the service method handlers.
type Handlers struct {
	// Attach handles golden.attach.
	Attach func(context.Context, *plug.RawStream) error
	// Connect handles golden.connect.
	Connect func(context.Context, ConnectRequest, *plug.RawStream) error
	// Get handles golden.get.
	Get func(context.Context, GetRequest) (plug.Option[Item], error)
	// ListItems handles golden.listItems.
	ListItems func(context.Context, ListItemsRequest) ([]Item, error)
	// Open handles golden.open.
	Open func(context.Context, OpenRequest, *plug.RawStream) error
	// Ping handles golden.ping.
	Ping func(context.Context) error
	// Update handles golden.update.
	Update func(context.Context, UpdateRequest) error
}

// RegisterHandlers registers every handler with server atomically. All fields must be non-nil.
func RegisterHandlers(server *plug.Server, h Handlers) error {
	batch := make([]plugimpl.Registration, 0, 7)
	if err := plugimpl.AppendRawHandlerNoReq(&batch, methodAttach, h.Attach, "Attach"); err != nil {
		return err
	}
	if err := plugimpl.AppendRawHandler(&batch, methodConnect, h.Connect, "Connect"); err != nil {
		return err
	}
	if err := plugimpl.AppendHandler(&batch, methodGet, h.Get, "Get"); err != nil {
		return err
	}
	if err := plugimpl.AppendHandler(&batch, methodListItems, h.ListItems, "ListItems"); err != nil {
		return err
	}
	if err := plugimpl.AppendRawHandler(&batch, methodOpen, h.Open, "Open"); err != nil {
		return err
	}
	if err := plugimpl.AppendHandlerNoReqVoid(&batch, methodPing, h.Ping, "Ping"); err != nil {
		return err
	}
	if err := plugimpl.AppendHandlerVoid(&batch, methodUpdate, h.Update, "Update"); err != nil {
		return err
	}

	return server.RegisterHandlers(batch)
}

// Client is the typed golden client.
type Client struct {
	raw *plug.Client
}

// NewClient returns a typed wrapper around raw.
func NewClient(raw *plug.Client) *Client { return &Client{raw: raw} }

// Close closes the underlying Plug client.
func (c *Client) Close() error { return c.raw.Close() }

// OpenAttach opens a raw stream without request fields.
func OpenAttach(ctx context.Context, conn net.Conn, opts plug.ClientOptions) (plug.RawConn, error) {
	return plug.OpenRaw(ctx, conn, methodAttach, plugimpl.Void{}, opts)
}

// OpenConnect opens a raw stream or returns a declared error.
func OpenConnect(ctx context.Context, conn net.Conn, req ConnectRequest, opts plug.ClientOptions) (plug.RawConn, error) {
	return plug.OpenRaw(ctx, conn, methodConnect, req, opts)
}

// Get returns an item when it exists.
//
// # Lookup
//
// See Item, golden.update, and golden.open. Unknown [Missing] stays literal.
//
//   - Return an Item.
//   - Report an APIError on failure.
//
// Example:
//
//	[golden.get] id: 1
//	    [Item]
func (c *Client) Get(ctx context.Context, req GetRequest) (plug.Option[Item], error) {
	return plug.Call(ctx, c.raw, methodGet, req)
}

// ListItems lists items up to the optional limit.
func (c *Client) ListItems(ctx context.Context, req ListItemsRequest) ([]Item, error) {
	return plug.Call(ctx, c.raw, methodListItems, req)
}

// OpenOpen opens a raw stream.
func OpenOpen(ctx context.Context, conn net.Conn, req OpenRequest, opts plug.ClientOptions) (plug.RawConn, error) {
	return plug.OpenRaw(ctx, conn, methodOpen, req, opts)
}

// Ping checks service health.
func (c *Client) Ping(ctx context.Context) error {
	_, err := plug.Call(ctx, c.raw, methodPing, plugimpl.Void{})
	return err
}

// Update updates an item.
func (c *Client) Update(ctx context.Context, req UpdateRequest) error {
	_, err := plug.Call(ctx, c.raw, methodUpdate, req)
	return err
}

// HTTPRoutes returns every HTTP binding declared by the schema.
func HTTPRoutes(server *plug.Server) []plughttp.Route {
	return []plughttp.Route{
		plughttp.NewRoute(server, methodGet, plughttp.Binding{
			Verb: "GET",
			Path: "/items/{id}",
		}),
		plughttp.NewRoute(server, methodGet, plughttp.Binding{
			Verb: "POST",
			Path: "/lookup",
		}),
		plughttp.NewRoute(server, methodListItems, plughttp.Binding{
			Verb: "GET",
			Path: "/items",
		}),
		plughttp.NewRoute(server, methodPing, plughttp.Binding{
			Verb: "GET",
			Path: "/healthz",
		}),
		plughttp.NewRoute(server, methodUpdate, plughttp.Binding{
			Verb: "PUT",
			Path: "/items/{id}",
		}),
	}
}
